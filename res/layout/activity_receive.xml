<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:orientation="vertical"
    android:padding="16dp">

    <Button
        android:id="@+id/btn_back"
        style="?android:attr/borderlessButtonStyle"
        android:layout_width="wrap_content"
        android:layout_height="36dp"
        android:minWidth="0dp"
        android:onClick="goBack"
        android:text="‹ 返回首页"
        android:textColor="@color/primary"
        android:textSize="13sp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="接收文件"
        android:textColor="@color/text"
        android:textSize="20sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="保持接收开启，对方就能把文件传过来"
        android:textColor="@color/sub"
        android:textSize="13sp" />

    <View android:layout_width="1dp" android:layout_height="12dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_card"
        android:orientation="vertical"
        android:padding="18dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="把这个 IP 填到对方手机"
            android:textColor="@color/sub"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/tv_ip"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:paddingTop="8dp"
            android:text="未连接 Wi‑Fi"
            android:textColor="@color/primary"
            android:textSize="30sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_port"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:paddingTop="4dp"
            android:text="端口 8765"
            android:textColor="@color/sub"
            android:textSize="13sp" />

        <Button
            android:id="@+id/btn_copy"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:layout_gravity="center_horizontal"
            android:text="复制 IP"
            android:textColor="@color/primary"
            android:textSize="13sp" />
    </LinearLayout>

    <View android:layout_width="1dp" android:layout_height="12dp" />

    <Button
        android:id="@+id/btn_toggle"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:background="@drawable/bg_btn"
        android:text="开始接收"
        android:textColor="@color/card"
        android:textSize="16sp"
        android:textStyle="bold" />

    <Button
        android:id="@+id/btn_install"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:background="@drawable/bg_btn_ghost"
        android:text="安装最近收到的 APK"
        android:textColor="@color/primary"
        android:textSize="14sp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/tv_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingTop="10dp"
        android:text="未启动"
        android:textColor="@color/sub"
        android:textSize="13sp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingTop="12dp"
        android:text="接收记录（文件保存在 下载/CrossShare）"
        android:textColor="@color/text"
        android:textSize="14sp"
        android:textStyle="bold" />

    <ListView
        android:id="@+id/lv_logs"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:divider="@drawable/bg_divider"
        android:dividerHeight="1dp" />
</LinearLayout>
